<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 소음 측정·동영상 녹화 소리 (사용할 때만 묻습니다) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 앱 권한 점검: 설치된 앱 목록 보기 (휴대폰 안에서만 확인, 밖으로 보내지 않음) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".SelfCheckApp"
        android:label="셀프 점검"
        android:icon="@android:drawable/ic_menu_search"
        android:theme="@style/Theme.SelfCheck"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".PhotoActivity" android:exported="false" />
        <activity android:name=".Face3DActivity" android:exported="false" />
        <activity android:name=".EditActivity" android:exported="false" />
        <activity android:name=".ReenactActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".BgRemoveActivity" android:exported="false" />
        <activity android:name=".ChromaKeyActivity" android:exported="false" />
        <activity android:name=".PersonActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PlateActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".LiveActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".FaceScanActivity" android:exported="false" />
        <activity android:name=".FaceCompareActivity" android:exported="false" />
        <activity android:name=".VoiceChangerActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".PlateLookupActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ToolsActivity" android:exported="false" />
        <activity android:name=".PhotoToolActivity" android:exported="false" />
        <activity android:name=".LiveToolActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".UtilityActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SensorActivity" android:exported="false" android:screenOrientation="portrait" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
